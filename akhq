Sur dbt70 (le démarrage prend environ 20 secondes) :

systemctl is-active akhq; ss -ltn | grep -E ':8080|:28081'; ausearch -m avc -ts recent | grep -c denied
journalctl -u akhq -n 50 --no-pager | grep -E 'ERROR|Startup completed' | tail -5
curl -s http://localhost:28081/health; echo; curl -s http://localhost:28081/prometheus | head -3

