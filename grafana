c) Règles d’alerte
cat > /etc/prometheus/rules/kafka-cdc.yml <<'EOF'
groups:
  - name: infra
    rules:
      - alert: CibleInjoignable
        expr: up == 0
        for: 2m
        labels: { severity: critical }
        annotations: { summary: "{{ $labels.job }} injoignable : {{ $labels.instance }}" }
      - alert: ServiceEnEchec
        expr: node_systemd_unit_state{state="failed"} == 1
        for: 1m
        labels: { severity: critical }
        annotations: { summary: "Service {{ $labels.name }} en échec sur {{ $labels.host }}" }
      - alert: SondeEnEchec
        expr: probe_success == 0
        for: 2m
        labels: { severity: critical }
        annotations: { summary: "Sonde KO : {{ $labels.instance }}" }
      - alert: FSKafkaPlein80
        expr: node_filesystem_avail_bytes{mountpoint="/inte/vq/DAT/data/KFK"} / node_filesystem_size_bytes{mountpoint="/inte/vq/DAT/data/KFK"} < 0.20
        for: 10m
        labels: { severity: warning }
        annotations: { summary: "FS Kafka > 80% sur {{ $labels.host }}" }
      - alert: FSKafkaPlein90
        expr: node_filesystem_avail_bytes{mountpoint="/inte/vq/DAT/data/KFK"} / node_filesystem_size_bytes{mountpoint="/inte/vq/DAT/data/KFK"} < 0.10
        for: 5m
        labels: { severity: critical }
        annotations: { summary: "FS Kafka > 90% sur {{ $labels.host }}" }
      - alert: FSPresquePlein
        expr: node_filesystem_avail_bytes{fstype=~"xfs|ext4",mountpoint!="/inte/vq/DAT/data/KFK"} / node_filesystem_size_bytes{fstype=~"xfs|ext4",mountpoint!="/inte/vq/DAT/data/KFK"} < 0.10
        for: 15m
        labels: { severity: warning }
        annotations: { summary: "FS {{ $labels.mountpoint }} > 90% sur {{ $labels.host }}" }

  - name: kafka
    rules:
      - alert: KafkaPartitionsSousRepliquees
        expr: kafka_server_replicamanager_underreplicatedpartitions > 0
        for: 5m
        labels: { severity: warning }
        annotations: { summary: "{{ $value }} partition(s) sous-répliquée(s) sur {{ $labels.host }}" }
      - alert: KafkaSousMinIsr
        expr: kafka_server_replicamanager_underminisrpartitioncount > 0
        for: 1m
        labels: { severity: critical }
        annotations: { summary: "Partitions sous min.insync.replicas sur {{ $labels.host }} : écritures bloquées" }
      - alert: KafkaPartitionsHorsLigne
        expr: max(kafka_controller_kafkacontroller_offlinepartitionscount) > 0
        for: 1m
        labels: { severity: critical }
        annotations: { summary: "Partitions hors ligne" }
      - alert: KafkaControllerActif
        expr: sum(kafka_controller_kafkacontroller_activecontrollercount) != 1
        for: 1m
        labels: { severity: critical }
        annotations: { summary: "Nombre de controllers actifs différent de 1" }
      - alert: KafkaBrokersManquants
        expr: kafka_brokers < 3
        for: 2m
        labels: { severity: critical }
        annotations: { summary: "Seulement {{ $value }} broker(s) dans le cluster" }

  - name: connect-debezium
    rules:
      - alert: ConnecteurEnEchec
        expr: kafka_connect_connector_status{status="failed"} == 1
        for: 1m
        labels: { severity: critical }
        annotations: { summary: "Connecteur {{ $labels.connector }} en échec" }
      - alert: TacheEnEchec
        expr: kafka_connect_task_status{status="failed"} == 1
        for: 1m
        labels: { severity: critical }
        annotations: { summary: "Tâche {{ $labels.task }} du connecteur {{ $labels.connector }} en échec" }
      - alert: DebeziumDeconnecte
        expr: debezium_metrics_connected{context="streaming"} == 0
        for: 2m
        labels: { severity: critical }
        annotations: { summary: "Debezium {{ $labels.name }} déconnecté de la base" }
      - alert: DebeziumRetard
        expr: debezium_metrics_millisecondsbehindsource{context="streaming"} > 300000
        for: 10m
        labels: { severity: warning }
        annotations: { summary: "Debezium {{ $labels.name }} a plus de 5 min de retard" }
      - alert: ConsommateurEnRetard
        expr: sum by (consumergroup, topic) (kafka_consumergroup_lag) > 100000
        for: 15m
        labels: { severity: warning }
        annotations: { summary: "Groupe {{ $labels.consumergroup }} en retard sur {{ $labels.topic }} ({{ $value }} messages)" }
EOF

Le seuil de ConsommateurEnRetard, fixé à 100 000 messages, est provisoire. On l’ajustera quand on connaîtra les volumes.

