Description=Prometheus Alertmanager
After=network-online.target

[Service]
User=alertmanager
Group=alertmanager
ExecStart=/usr/local/bin/alertmanager --config.file=/etc/alertmanager/alertmanager.yml --web.config.file=/etc/alertmanager/web.yml --storage.path=/inte/vq/DAT/data/AKH/alertmanager --web.listen-address=0.0.0.0:9093 --cluster.listen-address= --web.external-url=http://mcq-dbt70.cgi.credit-cgi.fr:9093/
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
